<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!--
                  Vista previa: lo que llega por el puerto 9090 se pide al sistema IOT, así la miniatura queda en el
                  mismo servidor que el Log Board y la página puede leer su sesión. Esta regla debe ir primero.
                  Requisitos en el servidor: módulo "Application Request Routing", el proxy habilitado con
                  preserveHostHeader, el puerto 9090 agregado a los enlaces (bindings) de este sitio y abierto en el firewall.
                  En el Log Board: Aplicaciones, editar IOT, "Dirección para la vista previa" = http://192.168.130.49:9090
                -->
                <rule name="Vista previa IOT" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{SERVER_PORT}" pattern="^9090$" />
                    </conditions>
                    <action type="Rewrite" url="http://192.168.130.50:9080/{R:1}" />
                </rule>
                <rule name="Imported Rule 1" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>
                <rule name="Imported Rule 2" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
